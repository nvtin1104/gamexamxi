{
  "name": "gamexamxi-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gamexamxi — landing page + mini-game tích hợp cho học sinh, deploy trên Cloudflare Pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pages:dev": "npm run build && npx wrangler pages dev dist",
    "pages:deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
